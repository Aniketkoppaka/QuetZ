# ─── autonomous-software-engineer — Environment Configuration Template ─────────
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# This file documents ALL recognised environment variables for the project.
# Entries marked [REQUIRED] must be set for the system to function.
# Entries marked [OPTIONAL] have sane defaults if omitted.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# [REQUIRED] API key for the primary LLM provider (e.g. Anthropic, OpenAI)
LLM_API_KEY=

# [OPTIONAL] Specific model identifier to use
# Default will be determined in Milestone 1 when LLM integration is designed.
LLM_MODEL=

# [OPTIONAL] LLM inference timeout in seconds
LLM_TIMEOUT_SECONDS=

# [OPTIONAL] Maximum tokens per LLM response
LLM_MAX_TOKENS=

# ── GitHub Integration ────────────────────────────────────────────────────────
# [REQUIRED for GitHub operations] Personal access token or GitHub App private key
GITHUB_TOKEN=

# [OPTIONAL] GitHub API base URL (override for GitHub Enterprise)
GITHUB_API_BASE_URL=https://api.github.com

# ── Execution & Sandbox ───────────────────────────────────────────────────────
# [OPTIONAL] Docker image to use for sandboxed test execution
SANDBOX_DOCKER_IMAGE=

# [OPTIONAL] Maximum wall-clock time (seconds) allowed per sandboxed execution
SANDBOX_EXECUTION_TIMEOUT_SECONDS=

# [OPTIONAL] Maximum RAM (MB) available to a sandboxed container
SANDBOX_MEMORY_LIMIT_MB=

# ── Repair Loop ───────────────────────────────────────────────────────────────
# [OPTIONAL] Maximum number of repair iterations before the agent gives up
MAX_REPAIR_ITERATIONS=

# ── Repository Configuration ──────────────────────────────────────────────────
# [OPTIONAL] Local directory where cloned repositories are stored
REPO_WORKSPACE_DIR=

# ── Logging & Observability ───────────────────────────────────────────────────
# [OPTIONAL] Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# [OPTIONAL] Directory for structured log output
LOG_OUTPUT_DIR=

# [OPTIONAL] Enable structured JSON logging (true/false)
LOG_JSON=false
